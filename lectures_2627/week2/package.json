{
  "name": "beyond-mlr-week2-slides",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "interaction-data": "Rscript generate_interaction_data.R",
    "allocation-data": "Rscript explore_allocation_imbalance.R",
    "additive-example": "Rscript generate_additive_example.R",
    "figures": "npm run allocation-data && npm run interaction-data && npm run additive-example",
    "equations": "node generate_equations.js",
    "slides": "node build_week2.js",
    "render": "node ../../scripts/render_lecture.js Beyond_MLR_Week_2.pptx",
    "build": "npm run slides && npm run render",
    "rebuild": "npm run figures && npm run equations && npm run build",
    "cluster-starter": "node build_cluster_starter.js"
  },
  "dependencies": {
    "jszip": "3.10.1",
    "pptxgenjs": "4.0.1",
    "mathjax-full": "3.2.1",
    "skia-canvas": "3.0.8",
    "fontkit": "2.0.4",
    "linebreak": "1.1.0",
    "prismjs": "1.30.0"
  }
}
