.Rproj.user
.Rhistory
.RData
.Ruserdata

# Quarto project cache (do not commit)
**/.quarto/
project-cache/
preview/

# Keep website output `docs/` for GitHub Pages tracked.
# Site libraries will be tracked under docs/site_libs/ for Pages deployment.

# Quarto notebooks
**/*.quarto_ipynb

# Old lectures folder (not a generated file)
/Lectures_2425

# Lecture slides (revealjs) build artifacts — ignore per-slide generated folders and local HTML not intended for repo
lectures_2526/*_files/
lectures_2526/*_cache/
lectures_2526/*_reveal*/
lectures_2526/*.reveal.html
lectures_2526/*.html

# Explicitly ignore rendered slide presentations and slide stylesheet
lectures_2526/_slides/
lectures_2526/_slides/**

# Generated equation intermediates; definitions live in the slide JavaScript.
# Keep equation PNGs tracked so decks build without a local TeX installation.
lectures_*/**/assets/equations/*.tex
lectures_*/**/assets/equations/*.svg
lectures_*/**/assets/equations/*.aux
lectures_*/**/assets/equations/*.log
lectures_*/**/assets/equations/*.out
lectures_*/**/assets/equations/*.pdf
lectures_*/**/assets/equations/*.fls
lectures_*/**/assets/equations/*.fdb_latexmk
lectures_*/**/assets/equations/*.synctex.gz

# Editor / OS
.Rproj.user/
.vscode/
.DS_Store
Thumbs.db

# Edition-specific preview builds and private submission folders
**/_site/
**/student_submissions/
**/Final_assignment_submissions/

# Local JavaScript dependencies and disposable lecture-rendering files
node_modules/
.cache/
npm-debug.log*
